{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aether Desktop",
  "version": "1.2.0",
  "identifier": "com.mahan07dev.aetherdesktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Aether Desktop",
        "width": 800,
        "height": 600,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
      "category": "Utility",

  "shortDescription": "A more user friendly approach to use aether tunneling program.",

  "longDescription": "Run aether tunneling program terminal codes directly in my app without any problems. 100% fast and free.",

  "publisher": "Mahan07dev",

  "copyright": "© 2026 Mahan07dev",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
